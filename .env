# Copy to `.env` and fill in. `.env` is git-ignored.

# Application under test
BASE_URL=https://pre-beta-sakani.housingapps.sa

# Beta identity used for authenticated journeys.
# Nafath auto-approves this identifier on beta (no phone interaction needed).
SAKANI_NATIONAL_ID=1119880042

# Display name rendered in the header once authenticated. Used only to assert
# that the session belongs to the expected identity.
SAKANI_USER_NAME=الأخضر

# Non-Saudi beta identity, used only by SAKANI-47569-02 and -03.
SAKANI_NON_SAUDI_NATIONAL_ID=2445566666

# UI language for the rebranded pages: ar | en
# The site stores this in `localStorage.language`; the suite seeds it directly
# rather than clicking the header toggle on every navigation.
SAKANI_LANG=ar
