# Copy to `.env` and fill in. `.env` is git-ignored — never commit real identities.

# Application under test (no trailing slash needed)
BASE_URL=https://pre-beta-sakani.housingapps.sa

# Saudi beta identity used for authenticated journeys (Nafath auto-approves on beta).
SAKANI_NATIONAL_ID=
# Fragment of the display name the header renders once that identity is signed in.
SAKANI_USER_NAME=

# Non-Saudi (iqama) beta identity, used only by SAKANI-47569-02 and -03.
SAKANI_NON_SAUDI_NATIONAL_ID=

# UI language for the rebranded pages: ar | en
SAKANI_LANG=ar

# Set to 1 to run without a browser window.
HEADLESS=
